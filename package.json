{
  "name": "ulanzi-window-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ulanzi dial as a window controller: rotate to scroll windows (terminals or all) and press to focus, plus komorebi tiling controls on the knob and keys.",
  "scripts": {
    "build": "node scripts/sync-engine.mjs",
    "setup:plugin": "npm --prefix plugin/com.ulanzi.windowcontrol.ulanziPlugin install",
    "install:plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-plugin.ps1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-plugin.ps1",
    "test": "node test/smoke.mjs"
  }
}
